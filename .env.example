# ──────────────────────────────────────────────────────────────────────────────
# .env.example
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── LLM Configuration ───────────────────────────────────────────────────────
# LiteLLM model string. Examples:
#   mistral/mistral-small-latest   (default)
#   mistral/mistral-medium-latest
#   mistral/mistral-large-latest
#   openai/gpt-4o-mini
#   anthropic/claude-3-5-haiku-20241022
LLM_MODEL=mistral/mistral-small-latest

# API key for your chosen LLM provider (only set the one you use)
MISTRAL_API_KEY=your-mistral-api-key-here
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...

# ─── Database & Auth (Supabase) ───────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# PostgreSQL connection string (use the Session Pooler URL from Supabase)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# ─── Chunking Configuration (Fixed Semantic Chunking) ────────────────────────
# These control how PDF text is split before being sent to the LLM.
# Chunk size is DOCUMENT-DRIVEN — it does NOT change based on question count.
PREFERRED_CHUNK_SIZE=1000     # Target tokens per chunk (~750 words)
MIN_CHUNK_SIZE=700            # Minimum — chunks below this are filtered out
MAX_CHUNK_SIZE=1500           # Maximum — no single chunk exceeds this
CHUNK_OVERLAP=100             # Overlap tokens shared between adjacent chunks

# ─── Questions Per Chunk (Over-generation strategy) ───────────────────────────
# The pipeline intentionally over-generates then trims to the requested count.
# QPQ = clamp(ceil(requested / num_chunks), MIN, MAX)
MIN_QUESTIONS_PER_CHUNK=2
MAX_QUESTIONS_PER_CHUNK=5

# ─── Quiz Limits ─────────────────────────────────────────────────────────────
DEFAULT_TOTAL_QUESTIONS=20
# Comma-separated list of allowed question counts shown in the UI
# ALLOWED_QUESTION_COUNTS=10,20,30,50,75,100,150
MAX_PAGES_PER_REQUEST=100

# ─── App Configuration ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# ─── Server (Docker / Production only) ───────────────────────────────────────
# These are used by Gunicorn inside the Docker container.
# Not needed for local uvicorn development.
PORT=8000
WORKERS=2
TIMEOUT=120

# ─── Optional: LangSmith Tracing ────────────────────────────────────────────
# Get your API key from: https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=pdf2quiz
