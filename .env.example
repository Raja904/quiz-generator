# ─── LLM Configuration ──────────────────────────────────────────────────────
# LiteLLM model string. Examples:
#   mistral/mistral-small-latest
#   mistral/mistral-medium-latest
#   mistral/mistral-large-latest
#   openai/gpt-4o-mini
#   anthropic/claude-3-5-haiku-20241022
#   google/gemini-2.0-flash
LLM_MODEL=mistral/mistral-small-latest

# API key for your chosen provider
MISTRAL_API_KEY=your-mistral-api-key-here
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...

# ─── Database & Auth (Supabase) ──────────────────────────────────────────────
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# PostgreSQL connection string (asyncpg format)
# e.g. postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=your-database-url

# ─── Adaptive Chunking ───────────────────────────────────────────────────────
# Chunk size is derived automatically from (total_tokens / total_questions).
# These are the floor and ceiling bounds, in tokens.
MIN_CHUNK_SIZE=300
MAX_CHUNK_SIZE=3000

# Fraction of chunk_size to carry forward as overlap between chunks (0.0–1.0)
CHUNK_OVERLAP_RATIO=0.10

# ─── Quiz Configuration ──────────────────────────────────────────────────────
# Default if the caller does not supply total_questions
DEFAULT_TOTAL_QUESTIONS=20

# Maximum number of pages that can be selected in a single request
MAX_PAGES_PER_REQUEST=100

# ─── App Configuration ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
